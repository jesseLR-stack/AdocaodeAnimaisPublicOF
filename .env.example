# Copie para .env.local e preencha.
# Local: valores exibidos por `npx supabase start`.
# Produção: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada apenas no servidor (exclusão de conta, seed).
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site (ex.: https://adoteamigo.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para o hash de IP do formulário de contato (qualquer texto aleatório)
IP_HASH_SALT=
# Senha das contas criadas por `npm run seed` (opcional)
SEED_PASSWORD=
